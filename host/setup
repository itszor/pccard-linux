#!/bin/bash
# The Risc PC's network, on this machine's eth1, cabled to the Risc PC:
# this end is 192.168.1.251 (the Risc PC's gateway, for ./nat), and eth1
# goes in firewalld's trusted zone. Runtime only, like ./nat.
sudo ifconfig eth1 192.168.1.251 netmask 255.255.255.0
sudo ip route add 192.168.1.0/24 dev eth1
sudo firewall-cmd --zone=trusted --change-interface=eth1
