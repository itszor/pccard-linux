# Linux 4.19 for Aleph One's PC card under !PC: a fixed machine, so no
# probing, initrd or modules it doesn't need. Merged over tinyconfig.
CONFIG_M486=y
CONFIG_NOHIGHMEM=y
CONFIG_KERNEL_GZIP=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_SWAP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_ISA=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT2_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MSDOS_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
# No RTC driver. !PC raises IRQ 8 at 1024Hz all the time, whatever the
# periodic-interrupt enable bit says, so rtc-cmos would take IRQ 8 and
# then refuse every interrupt ("irq 8: nobody cared"). The kernel reads the
# clock at boot without it, from the CMOS ports !PC fills from RISC OS's.
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2000=y
CONFIG_ALEPHPC_APCDISK=y
# A kernel SYSLINUX may put anywhere: placed only at 1MB, it would not boot.
CONFIG_RELOCATABLE=y

# !PC's Logitech bus mouse, at 0x23c, on BusMouseInt (logibm.irq=, 3).
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_LOGIBM=y

# For programs that watch files (ROX-Filer among them).
CONFIG_INOTIFY_USER=y
